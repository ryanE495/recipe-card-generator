---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Recipe Cards — Beautiful Cards from Any Recipe Photo">
  <div class="no-print">
    <header>
      <div class="container">
        <div class="header-flourish">
          <svg class="flourish-svg" viewBox="0 0 200 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 10 Q50 0 100 10 Q150 20 200 10" stroke="currentColor" stroke-width="1" fill="none" opacity="0.3"/>
          </svg>
        </div>
        <div class="logo">
          <div class="logo-badge">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="1"/><circle cx="24" cy="24" r="19" stroke="currentColor" stroke-width="0.5" opacity="0.4"/><text x="24" y="30" text-anchor="middle" font-size="22">🍽</text></svg>
          </div>
          <h1>Recipe Cards</h1>
          <p class="tagline">Upload a recipe photo &middot; get a beautiful keepsake card</p>
        </div>
        <div class="header-flourish bottom">
          <svg class="flourish-svg" viewBox="0 0 200 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 10 Q50 20 100 10 Q150 0 200 10" stroke="currentColor" stroke-width="1" fill="none" opacity="0.3"/>
          </svg>
        </div>
      </div>
    </header>

    <main class="container" id="app">
      <section id="upload-section" class="fade-up">
        <div id="drop-zone" class="drop-zone">
          <div class="drop-zone-border"></div>
          <div class="drop-zone-content">
            <div class="upload-icon-wrap">
              <div class="upload-icon">📸</div>
              <div class="icon-ring"></div>
            </div>
            <h2>Drop your recipe here</h2>
            <p>Handwritten cards, cookbook pages, screenshots — anything goes</p>
            <div class="upload-hint">
              <span class="hint-line"></span>
              <span>or click to browse</span>
              <span class="hint-line"></span>
            </div>
            <input type="file" id="file-input" accept="image/*" hidden />
          </div>
          <div id="preview-container" class="preview-container" style="display:none;">
            <img id="preview-image" alt="Preview" />
            <button id="remove-image" class="btn-remove" title="Remove">✕</button>
          </div>
        </div>
        <button id="extract-btn" class="btn-primary" style="display:none;">
          <span class="btn-text">
            <span class="btn-icon">✨</span> Extract Recipe
          </span>
          <span class="btn-loading" style="display:none;">
            <span class="spinner"></span> Reading your recipe...
          </span>
        </button>
      </section>

      <div id="error-msg" class="error-msg" style="display:none;"></div>
    </main>
  </div>

  <!-- Recipe Card Output -->
  <section id="card-section" class="container" style="display:none;">
    <div class="no-print card-controls fade-up">
      <div class="controls-header">
        <div class="controls-flourish">
          <span class="flourish-leaf">🌿</span>
        </div>
        <h2>Your Recipe Card</h2>
      </div>
      <div class="template-picker">
        <button class="tmpl-btn active" data-template="classic">
          <span class="tmpl-icon">📜</span> Classic
        </button>
        <button class="tmpl-btn" data-template="modern">
          <span class="tmpl-icon">✦</span> Modern
        </button>
        <button class="tmpl-btn" data-template="minimal">
          <span class="tmpl-icon">〇</span> Minimal
        </button>
        <button class="tmpl-btn" data-template="farmhouse">
          <span class="tmpl-icon">🌾</span> Farmhouse
        </button>
      </div>
    </div>
    <div id="recipe-card" class="recipe-card template-classic fade-up"></div>
    <div class="no-print action-bar fade-up">
      <button id="print-btn" class="btn-action">
        <span>🖨</span> Print
      </button>
      <button id="download-btn" class="btn-action">
        <span>📥</span> Download
      </button>
      <button id="email-btn" class="btn-action">
        <span>✉️</span> Email HTML
      </button>
      <button id="new-btn" class="btn-new">+ New Recipe</button>
    </div>
  </section>

  <!-- Email HTML Modal -->
  <div id="email-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <button id="close-modal" class="btn-remove modal-close">✕</button>
      <h3>Email-Friendly HTML</h3>
      <p>Copy and paste into your email composer:</p>
      <textarea id="email-html" readonly rows="12"></textarea>
      <button id="copy-email" class="btn-primary" style="margin-top:12px;">📋 Copy to Clipboard</button>
    </div>
  </div>

  <!-- Decorative footer -->
  <footer class="no-print">
    <div class="container">
      <div class="footer-flourish">
        <svg viewBox="0 0 300 30" fill="none" class="footer-svg">
          <path d="M0 15 Q75 0 150 15 Q225 30 300 15" stroke="currentColor" stroke-width="0.8" fill="none" opacity="0.2"/>
        </svg>
      </div>
      <p class="footer-text">Made with care ✨</p>
    </div>
  </footer>

<style>
  /* ===== HEADER ===== */
  header {
    text-align: center;
    padding: 56px 0 40px;
    position: relative;
  }
  .header-flourish {
    color: var(--sage);
    margin-bottom: 16px;
  }
  .header-flourish.bottom {
    margin-top: 20px;
    margin-bottom: 0;
  }
  .flourish-svg {
    width: 200px;
    height: 20px;
    display: inline-block;
  }
  .logo-badge {
    color: var(--sage);
    margin-bottom: 12px;
    display: inline-block;
    animation: float 4s ease-in-out infinite;
  }
  .logo h1 {
    font-size: 3rem;
    color: var(--dark);
    margin: 0 0 8px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }
  .tagline {
    color: var(--warm-gray);
    font-size: 1.05rem;
    font-family: 'Lora', serif;
    font-style: italic;
    font-weight: 400;
  }

  /* ===== UPLOAD ===== */
  .drop-zone {
    border-radius: 24px;
    padding: 64px 32px;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    background: var(--warm-white);
    position: relative;
    overflow: hidden;
  }
  .drop-zone-border {
    position: absolute;
    inset: 8px;
    border: 2px dashed var(--sage-light);
    border-radius: 18px;
    pointer-events: none;
    transition: var(--transition);
  }
  .drop-zone:hover .drop-zone-border,
  .drop-zone.drag-over .drop-zone-border {
    border-color: var(--sage);
    inset: 6px;
  }
  .drop-zone:hover, .drop-zone.drag-over {
    background: var(--parchment);
    transform: scale(1.005);
    box-shadow: 0 8px 32px rgba(60,53,44,0.08);
  }
  .upload-icon-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: 16px;
  }
  .upload-icon {
    font-size: 3.2rem;
    position: relative;
    z-index: 1;
  }
  .icon-ring {
    position: absolute;
    inset: -12px;
    border: 1.5px solid var(--sage-light);
    border-radius: 50%;
    opacity: 0.5;
  }
  .drop-zone h2 {
    font-size: 1.5rem;
    margin-bottom: 8px;
    color: var(--dark);
    font-weight: 600;
  }
  .drop-zone p {
    color: var(--warm-gray);
    font-size: 0.95rem;
    margin-bottom: 20px;
  }
  .upload-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: var(--warm-gray);
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .hint-line {
    width: 40px;
    height: 1px;
    background: var(--sage-light);
  }
  .preview-container {
    position: relative;
    display: inline-block;
  }
  .preview-container img {
    max-width: 100%;
    max-height: 380px;
    border-radius: 16px;
    object-fit: contain;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .btn-remove {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(60,53,44,0.7);
    color: white;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    transition: var(--transition);
  }
  .btn-remove:hover { background: rgba(60,53,44,0.9); transform: scale(1.1); }

  /* ===== BUTTONS ===== */
  .btn-primary {
    display: block;
    margin: 28px auto 0;
    padding: 18px 48px;
    background: var(--sage);
    color: white;
    border: none;
    border-radius: 60px;
    font-size: 1.1rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Lora', serif;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.1) 50%, transparent 60%);
    transform: translateX(-100%);
    transition: transform 0.6s;
  }
  .btn-primary:hover::before { transform: translateX(100%); }
  .btn-primary:hover {
    background: var(--sage-dark);
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(122,139,111,0.35);
  }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .btn-icon { margin-right: 4px; }

  .btn-action {
    padding: 14px 28px;
    background: var(--warm-white);
    border: 1.5px solid var(--cream-dark);
    border-radius: 60px;
    color: var(--dark);
    font-size: 0.9rem;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Lora', serif;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-action:hover {
    border-color: var(--sage);
    background: var(--parchment);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .btn-new {
    padding: 14px 28px;
    background: transparent;
    border: 1.5px solid var(--terracotta-light);
    border-radius: 60px;
    color: var(--terracotta);
    font-size: 0.9rem;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Lora', serif;
  }
  .btn-new:hover { background: var(--terracotta); color: white; transform: translateY(-2px); }

  .spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 6px;
  }
  .error-msg {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #B91C1C;
    padding: 16px 24px;
    border-radius: 16px;
    margin-top: 24px;
    text-align: center;
    font-size: 0.95rem;
  }

  /* ===== CARD CONTROLS ===== */
  .card-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 56px 0 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .controls-header { display: flex; align-items: center; gap: 12px; }
  .controls-flourish { font-size: 1.2rem; opacity: 0.6; }
  .card-controls h2 { font-size: 1.6rem; }
  .template-picker { display: flex; gap: 8px; flex-wrap: wrap; }
  .tmpl-btn {
    padding: 10px 22px;
    border-radius: 60px;
    border: 1.5px solid var(--cream-dark);
    background: var(--warm-white);
    color: var(--dark-soft);
    cursor: pointer;
    font-size: 0.85rem;
    font-family: 'Lora', serif;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tmpl-icon { font-size: 0.9rem; }
  .tmpl-btn.active, .tmpl-btn:hover {
    background: var(--sage);
    color: white;
    border-color: var(--sage);
    box-shadow: 0 2px 12px rgba(122,139,111,0.2);
  }
  .action-bar {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 32px 0 60px;
  }

  /* =======================================
     RECIPE CARD BASE
     ======================================= */
  .recipe-card {
    background: white;
    border-radius: 24px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    max-width: 780px;
    margin: 0 auto;
    position: relative;
  }

  /* ===== CLASSIC TEMPLATE ===== */
  .template-classic .card-header {
    background: linear-gradient(160deg, var(--sage) 0%, var(--sage-dark) 100%);
    color: white;
    padding: 44px 48px 36px;
    text-align: center;
    position: relative;
  }
  .template-classic .card-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: repeating-linear-gradient(90deg, var(--gold) 0px, var(--gold) 20px, transparent 20px, transparent 40px);
    opacity: 0.4;
  }
  .template-classic .card-header h2 {
    font-size: 2.2rem;
    margin-bottom: 8px;
    font-weight: 700;
  }
  .template-classic .card-header .desc {
    font-style: italic;
    opacity: 0.9;
    font-family: 'Lora', serif;
    font-size: 1rem;
  }
  .template-classic .card-meta {
    display: flex;
    justify-content: center;
    gap: 36px;
    padding: 20px 24px;
    background: var(--parchment);
    border-bottom: 1px solid var(--cream-dark);
    flex-wrap: wrap;
  }
  .template-classic .meta-item {
    text-align: center;
    font-size: 0.85rem;
    color: var(--warm-gray);
  }
  .template-classic .meta-item strong {
    display: block;
    font-size: 1.1rem;
    color: var(--sage-dark);
    font-family: 'Playfair Display', serif;
  }
  .template-classic .card-body { padding: 36px 48px 48px; }
  .template-classic .section-title {
    font-size: 1.25rem;
    color: var(--sage-dark);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--sage-muted);
    display: inline-block;
    position: relative;
  }
  .template-classic .ingredients-list {
    list-style: none;
    columns: 2;
    column-gap: 28px;
    margin-bottom: 36px;
  }
  .template-classic .ingredients-list li {
    padding: 6px 0 6px 24px;
    position: relative;
    break-inside: avoid;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .template-classic .ingredients-list li::before {
    content: '✦';
    position: absolute;
    left: 2px;
    color: var(--terracotta-light);
    font-size: 0.7rem;
    top: 10px;
  }
  .template-classic .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-classic .instructions-list li {
    padding: 14px 0 14px 52px;
    position: relative;
    border-bottom: 1px solid var(--linen);
    font-size: 0.95rem;
    counter-increment: step;
    line-height: 1.7;
  }
  .template-classic .instructions-list li:last-child { border-bottom: none; }
  .template-classic .instructions-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--sage-muted);
    color: var(--sage-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.85rem;
    font-family: 'Playfair Display', serif;
  }
  .template-classic .card-notes {
    margin-top: 28px;
    padding: 18px 24px;
    background: linear-gradient(135deg, #FFF8F0 0%, #FEF3E8 100%);
    border-left: 3px solid var(--terracotta-light);
    border-radius: 0 14px 14px 0;
    font-size: 0.9rem;
    color: var(--dark-soft);
    font-style: italic;
  }
  .template-classic .card-notes strong { color: var(--terracotta); font-style: normal; }

  /* ===== MODERN TEMPLATE ===== */
  .template-modern .card-header {
    background: var(--dark);
    color: white;
    padding: 48px 48px 36px;
    position: relative;
  }
  .template-modern .card-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--terracotta), var(--gold), var(--sage));
  }
  .template-modern .card-header h2 {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.5px;
  }
  .template-modern .card-header .desc {
    color: rgba(255,255,255,0.6);
    margin-top: 8px;
    font-weight: 400;
    font-family: 'Lora', serif;
  }
  .template-modern .card-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--terracotta);
    color: white;
    text-align: center;
  }
  .template-modern .meta-item {
    padding: 16px 12px;
    border-right: 1px solid rgba(255,255,255,0.15);
    font-size: 0.85rem;
  }
  .template-modern .meta-item:last-child { border-right: none; }
  .template-modern .meta-item strong {
    display: block;
    font-size: 1.15rem;
    font-family: 'Playfair Display', serif;
  }
  .template-modern .card-body { padding: 36px 48px 48px; }
  .template-modern .section-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--terracotta);
    margin-bottom: 18px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
  }
  .template-modern .ingredients-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 36px;
  }
  .template-modern .ingredients-list li {
    padding: 10px 16px;
    background: var(--linen);
    border-radius: 10px;
    font-size: 0.9rem;
  }
  .template-modern .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-modern .instructions-list li {
    padding: 14px 0 14px 56px;
    position: relative;
    font-size: 0.95rem;
    counter-increment: step;
    line-height: 1.7;
    border-bottom: 1px solid var(--linen);
  }
  .template-modern .instructions-list li:last-child { border-bottom: none; }
  .template-modern .instructions-list li::before {
    content: '0' counter(step);
    position: absolute;
    left: 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--terracotta-light);
  }
  .template-modern .card-notes {
    margin-top: 28px;
    padding: 18px 24px;
    background: var(--dark);
    color: rgba(255,255,255,0.8);
    border-radius: 14px;
    font-size: 0.9rem;
  }
  .template-modern .card-notes strong { color: var(--terracotta-light); }

  /* ===== MINIMAL TEMPLATE ===== */
  .template-minimal { border: 1px solid var(--cream-dark); }
  .template-minimal .card-header {
    padding: 44px 48px 12px;
  }
  .template-minimal .card-header h2 {
    font-size: 2.6rem;
    font-weight: 400;
    font-family: 'Caveat', cursive;
    color: var(--dark);
  }
  .template-minimal .card-header .desc {
    color: var(--warm-gray);
    font-size: 0.95rem;
    font-weight: 400;
  }
  .template-minimal .card-meta {
    display: flex;
    gap: 24px;
    padding: 16px 48px;
    font-size: 0.8rem;
    color: var(--warm-gray);
    flex-wrap: wrap;
  }
  .template-minimal .meta-item strong {
    color: var(--dark);
    margin-right: 4px;
  }
  .template-minimal .card-body {
    padding: 24px 48px 48px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 36px;
  }
  .template-minimal .section-title {
    font-family: 'Caveat', cursive;
    font-size: 1.5rem;
    color: var(--sage);
    margin-bottom: 14px;
    font-weight: 500;
  }
  .template-minimal .ingredients-list { list-style: none; }
  .template-minimal .ingredients-list li {
    padding: 7px 0;
    border-bottom: 1px dotted var(--cream-dark);
    font-size: 0.9rem;
  }
  .template-minimal .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-minimal .instructions-list li {
    padding: 10px 0;
    font-size: 0.9rem;
    counter-increment: step;
    line-height: 1.7;
  }
  .template-minimal .instructions-list li::before {
    content: counter(step) '.';
    color: var(--sage);
    font-weight: 600;
    margin-right: 10px;
  }
  .template-minimal .card-notes {
    grid-column: 1 / -1;
    padding: 16px 0;
    border-top: 1px solid var(--cream-dark);
    font-size: 0.85rem;
    color: var(--warm-gray);
    font-style: italic;
  }

  /* ===== FARMHOUSE TEMPLATE ===== */
  .template-farmhouse {
    background: var(--parchment);
    border: 2px solid var(--cream-dark);
    position: relative;
  }
  .template-farmhouse::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--sage-light);
    border-radius: 18px;
    pointer-events: none;
    opacity: 0.4;
  }
  .template-farmhouse .card-header {
    padding: 44px 48px 20px;
    text-align: center;
    position: relative;
  }
  .template-farmhouse .card-header::after {
    content: '— ✿ —';
    display: block;
    margin-top: 16px;
    color: var(--sage-light);
    font-size: 1rem;
    letter-spacing: 8px;
  }
  .template-farmhouse .card-header h2 {
    font-family: 'Caveat', cursive;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--dark);
    line-height: 1.2;
  }
  .template-farmhouse .card-header .desc {
    color: var(--warm-gray);
    font-style: italic;
    margin-top: 6px;
    font-size: 1rem;
  }
  .template-farmhouse .card-meta {
    display: flex;
    justify-content: center;
    gap: 32px;
    padding: 18px 24px;
    flex-wrap: wrap;
  }
  .template-farmhouse .meta-item {
    text-align: center;
    font-size: 0.85rem;
    color: var(--warm-gray);
    padding: 8px 20px;
    background: rgba(255,255,255,0.6);
    border-radius: 12px;
    border: 1px solid var(--cream-dark);
  }
  .template-farmhouse .meta-item strong {
    display: block;
    font-size: 1.05rem;
    color: var(--sage-dark);
    font-family: 'Caveat', cursive;
    font-size: 1.3rem;
  }
  .template-farmhouse .card-body { padding: 28px 48px 48px; }
  .template-farmhouse .section-title {
    font-family: 'Caveat', cursive;
    font-size: 1.6rem;
    color: var(--sage-dark);
    margin-bottom: 14px;
    text-align: center;
    position: relative;
  }
  .template-farmhouse .section-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 2px;
    background: var(--sage-light);
    margin: 8px auto 0;
  }
  .template-farmhouse .ingredients-list {
    list-style: none;
    columns: 2;
    column-gap: 28px;
    margin-bottom: 36px;
    padding: 20px 24px;
    background: rgba(255,255,255,0.5);
    border-radius: 16px;
    border: 1px dashed var(--sage-light);
  }
  .template-farmhouse .ingredients-list li {
    padding: 5px 0 5px 22px;
    position: relative;
    break-inside: avoid;
    font-size: 0.95rem;
  }
  .template-farmhouse .ingredients-list li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: var(--sage-light);
    font-size: 0.55rem;
    top: 11px;
  }
  .template-farmhouse .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-farmhouse .instructions-list li {
    padding: 14px 0 14px 48px;
    position: relative;
    font-size: 0.95rem;
    counter-increment: step;
    line-height: 1.8;
    border-bottom: 1px dashed var(--cream-dark);
  }
  .template-farmhouse .instructions-list li:last-child { border-bottom: none; }
  .template-farmhouse .instructions-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 12px;
    width: 32px;
    height: 32px;
    border: 2px solid var(--sage-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Caveat', cursive;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--sage-dark);
  }
  .template-farmhouse .card-notes {
    margin-top: 28px;
    padding: 20px 24px;
    background: rgba(255,255,255,0.5);
    border: 1px solid var(--cream-dark);
    border-radius: 14px;
    font-size: 0.9rem;
    color: var(--dark-soft);
    font-style: italic;
    text-align: center;
  }
  .template-farmhouse .card-notes strong {
    color: var(--sage-dark);
    font-style: normal;
    font-family: 'Caveat', cursive;
    font-size: 1.1rem;
  }

  /* ===== FOOTER ===== */
  footer {
    text-align: center;
    padding: 40px 0 32px;
  }
  .footer-svg { width: 300px; height: 30px; color: var(--sage); }
  .footer-text {
    margin-top: 12px;
    font-size: 0.85rem;
    color: var(--warm-gray);
    font-style: italic;
  }

  /* ===== MODAL ===== */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(60,53,44,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    backdrop-filter: blur(6px);
  }
  .modal-content {
    background: var(--warm-white);
    border-radius: 24px;
    padding: 36px;
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
  }
  .modal-close { position: absolute; top: 16px; right: 16px; }
  .modal-content h3 { margin-bottom: 8px; }
  .modal-content textarea {
    width: 100%;
    font-family: monospace;
    font-size: 0.8rem;
    border: 1px solid var(--cream-dark);
    border-radius: 12px;
    padding: 14px;
    resize: vertical;
    margin-top: 12px;
    background: white;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 640px) {
    .logo h1 { font-size: 2.2rem; }
    .drop-zone { padding: 48px 20px; }
    .template-classic .ingredients-list,
    .template-modern .ingredients-list,
    .template-farmhouse .ingredients-list { columns: 1; grid-template-columns: 1fr; }
    .template-classic .card-body,
    .template-modern .card-body,
    .template-farmhouse .card-body { padding: 24px 24px 36px; }
    .template-classic .card-header,
    .template-modern .card-header,
    .template-farmhouse .card-header { padding: 32px 24px 24px; }
    .template-minimal .card-body { grid-template-columns: 1fr; }
    .template-minimal .card-header { padding: 28px 24px 8px; }
    .template-minimal .card-meta { padding: 14px 24px; }
    .card-controls { justify-content: center; text-align: center; }
    .controls-header { width: 100%; justify-content: center; }
    .template-picker { justify-content: center; }
  }
</style>

<script>
  const $ = (s) => document.querySelector(s);
  const dropZone = $('#drop-zone');
  const fileInput = $('#file-input');
  const previewContainer = $('#preview-container');
  const previewImage = $('#preview-image');
  const extractBtn = $('#extract-btn');
  const uploadSection = $('#upload-section');
  const cardSection = $('#card-section');
  const recipeCard = $('#recipe-card');
  const errorMsg = $('#error-msg');
  let base64Image = '';
  let currentRecipe = null;
  let currentTemplate = 'classic';

  // --- Upload handling ---
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', () => { if (fileInput.files[0]) handleFile(fileInput.files[0]); });

  function handleFile(file) {
    if (!file.type.startsWith('image/')) return showError('Please upload an image file.');
    if (file.size > 20 * 1024 * 1024) return showError('Image must be under 20MB.');
    const reader = new FileReader();
    reader.onload = (e) => {
      base64Image = e.target.result;
      previewImage.src = base64Image;
      previewContainer.style.display = 'inline-block';
      dropZone.querySelector('.drop-zone-content').style.display = 'none';
      extractBtn.style.display = 'block';
      hideError();
    };
    reader.readAsDataURL(file);
  }

  $('#remove-image').addEventListener('click', (e) => {
    e.stopPropagation();
    base64Image = '';
    previewContainer.style.display = 'none';
    dropZone.querySelector('.drop-zone-content').style.display = 'block';
    extractBtn.style.display = 'none';
    fileInput.value = '';
  });

  // --- Extract ---
  extractBtn.addEventListener('click', async () => {
    if (!base64Image) return;
    extractBtn.disabled = true;
    extractBtn.querySelector('.btn-text').style.display = 'none';
    extractBtn.querySelector('.btn-loading').style.display = 'inline';
    hideError();
    try {
      const res = await fetch('/api/extract-recipe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image: base64Image }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to extract recipe');
      currentRecipe = data;
      renderCard();
      cardSection.style.display = 'block';
      cardSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      showError(err.message);
    } finally {
      extractBtn.disabled = false;
      extractBtn.querySelector('.btn-text').style.display = 'inline';
      extractBtn.querySelector('.btn-loading').style.display = 'none';
    }
  });

  // --- Render card ---
  function renderCard() {
    if (!currentRecipe) return;
    const r = currentRecipe;
    const ingredientsHtml = (r.ingredients || []).map(i => `<li>${i}</li>`).join('');
    const instructionsHtml = (r.instructions || []).map(i => `<li>${i}</li>`).join('');
    const notesHtml = r.notes ? `<div class="card-notes"><strong>Notes: </strong>${r.notes}</div>` : '';

    let bodyContent;
    if (currentTemplate === 'minimal') {
      bodyContent = `
        <div><h3 class="section-title">Ingredients</h3><ul class="ingredients-list">${ingredientsHtml}</ul></div>
        <div><h3 class="section-title">Instructions</h3><ol class="instructions-list">${instructionsHtml}</ol></div>
        ${notesHtml}`;
    } else {
      bodyContent = `
        <h3 class="section-title">Ingredients</h3>
        <ul class="ingredients-list">${ingredientsHtml}</ul>
        <h3 class="section-title">Instructions</h3>
        <ol class="instructions-list">${instructionsHtml}</ol>
        ${notesHtml}`;
    }

    recipeCard.className = `recipe-card template-${currentTemplate} fade-up`;
    recipeCard.innerHTML = `
      <div class="card-header">
        <h2>${r.title || 'Untitled Recipe'}</h2>
        ${r.description ? `<p class="desc">${r.description}</p>` : ''}
      </div>
      <div class="card-meta">
        <div class="meta-item"><strong>${r.prepTime || '—'}</strong> Prep</div>
        <div class="meta-item"><strong>${r.cookTime || '—'}</strong> Cook</div>
        <div class="meta-item"><strong>${r.servings || '—'}</strong> Servings</div>
      </div>
      <div class="card-body">${bodyContent}</div>
    `;
  }

  // --- Template switching ---
  document.querySelectorAll('.tmpl-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tmpl-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTemplate = btn.dataset.template;
      renderCard();
    });
  });

  // --- Actions ---
  $('#print-btn').addEventListener('click', () => window.print());

  $('#download-btn').addEventListener('click', async () => {
    const { default: html2canvas } = await import('html2canvas');
    const canvas = await html2canvas(recipeCard, { scale: 2, useCORS: true, backgroundColor: '#ffffff' });
    const a = document.createElement('a');
    a.download = `${(currentRecipe?.title || 'recipe').replace(/\s+/g, '-').toLowerCase()}-card.png`;
    a.href = canvas.toDataURL('image/png');
    a.click();
  });

  $('#email-btn').addEventListener('click', () => {
    if (!currentRecipe) return;
    const r = currentRecipe;
    const html = generateEmailHtml(r);
    $('#email-html').value = html;
    $('#email-modal').style.display = 'flex';
  });

  $('#close-modal').addEventListener('click', () => { $('#email-modal').style.display = 'none'; });
  $('#email-modal').addEventListener('click', (e) => { if (e.target === $('#email-modal')) $('#email-modal').style.display = 'none'; });

  $('#copy-email').addEventListener('click', () => {
    $('#email-html').select();
    navigator.clipboard.writeText($('#email-html').value);
    $('#copy-email').textContent = '✅ Copied!';
    setTimeout(() => { $('#copy-email').textContent = '📋 Copy to Clipboard'; }, 2000);
  });

  $('#new-btn').addEventListener('click', () => {
    cardSection.style.display = 'none';
    base64Image = '';
    previewContainer.style.display = 'none';
    dropZone.querySelector('.drop-zone-content').style.display = 'block';
    extractBtn.style.display = 'none';
    fileInput.value = '';
    currentRecipe = null;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  function generateEmailHtml(r) {
    const ingredients = (r.ingredients || []).map(i => `<li style="padding:4px 0;">${i}</li>`).join('');
    const instructions = (r.instructions || []).map((s, i) => `<li style="padding:6px 0;"><strong>${i + 1}.</strong> ${s}</li>`).join('');
    return `<div style="max-width:600px;margin:0 auto;font-family:Georgia,serif;color:#3C352C;">
  <div style="background:#7A8B6F;color:white;padding:32px 28px;text-align:center;border-radius:16px 16px 0 0;">
    <h1 style="margin:0;font-size:26px;font-family:Georgia,serif;">${r.title || 'Recipe'}</h1>
    ${r.description ? `<p style="margin:8px 0 0;opacity:0.85;font-style:italic;">${r.description}</p>` : ''}
  </div>
  <div style="background:#F8F2E8;padding:14px 28px;text-align:center;font-size:14px;border-bottom:1px solid #E8DFD1;">
    <span>⏱ Prep: <strong>${r.prepTime || '—'}</strong></span> &nbsp;·&nbsp;
    <span>🔥 Cook: <strong>${r.cookTime || '—'}</strong></span> &nbsp;·&nbsp;
    <span>🍽 Serves: <strong>${r.servings || '—'}</strong></span>
  </div>
  <div style="background:white;padding:28px;border:1px solid #E8DFD1;">
    <h2 style="color:#5C6B52;font-size:18px;border-bottom:2px solid #D4DEC9;padding-bottom:8px;font-family:Georgia,serif;">Ingredients</h2>
    <ul style="list-style:disc;padding-left:20px;margin-top:12px;">${ingredients}</ul>
    <h2 style="color:#5C6B52;font-size:18px;border-bottom:2px solid #D4DEC9;padding-bottom:8px;margin-top:24px;font-family:Georgia,serif;">Instructions</h2>
    <ol style="list-style:none;padding:0;margin-top:12px;">${instructions}</ol>
    ${r.notes ? `<div style="margin-top:20px;padding:14px 18px;background:#FFF8F0;border-left:3px solid #DDA88E;font-size:14px;border-radius:0 8px 8px 0;font-style:italic;"><strong style="font-style:normal;">Notes:</strong> ${r.notes}</div>` : ''}
  </div>
  <div style="text-align:center;padding:18px;font-size:12px;color:#8A7F74;border-radius:0 0 16px 16px;background:#F8F2E8;">
    Made with ✨ Recipe Cards
  </div>
</div>`;
  }

  function showError(msg) { errorMsg.textContent = msg; errorMsg.style.display = 'block'; }
  function hideError() { errorMsg.style.display = 'none'; }
</script>
</Layout>
