---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Recipe Cards — Beautiful Vintage Cards from Any Recipe Photo">
  <div class="no-print">
    <header>
      <div class="container">
        <div class="header-ornament">✿ ✿ ✿</div>
        <div class="logo">
          <h1>Recipe Cards</h1>
          <div class="tagline-wrap">
            <span class="tagline-line"></span>
            <p class="tagline">from photo to keepsake</p>
            <span class="tagline-line"></span>
          </div>
        </div>
      </div>
    </header>

    <main class="container" id="app">
      <section id="upload-section" class="fade-up">
        <div id="drop-zone" class="drop-zone">
          <div class="drop-zone-border"></div>
          <div class="drop-zone-content">
            <div class="upload-icon">📸</div>
            <h2>Drop your recipe photo here</h2>
            <p>Handwritten cards, cookbook pages, screenshots — anything!</p>
            <div class="upload-hint">
              <span class="hint-line"></span>
              <span>or click to browse</span>
              <span class="hint-line"></span>
            </div>
            <input type="file" id="file-input" accept="image/*" hidden />
          </div>
          <div id="preview-container" class="preview-container" style="display:none;">
            <img id="preview-image" alt="Preview" />
            <button id="remove-image" class="btn-remove" title="Remove">✕</button>
          </div>
        </div>
        <button id="extract-btn" class="btn-primary" style="display:none;">
          <span class="btn-text">✨ Extract Recipe</span>
          <span class="btn-loading" style="display:none;">
            <span class="spinner"></span> Reading your recipe...
          </span>
        </button>
      </section>
      <div id="error-msg" class="error-msg" style="display:none;"></div>
    </main>
  </div>

  <!-- Recipe Card Output -->
  <section id="card-section" class="container" style="display:none;">
    <div class="no-print card-controls fade-up">
      <h2>Your Recipe Card</h2>
      <div class="pickers-row">
        <div class="picker-group">
          <label>Style</label>
          <div class="template-picker">
            <button class="tmpl-btn active" data-template="grandma">Grandma's</button>
            <button class="tmpl-btn" data-template="vintage">Vintage</button>
            <button class="tmpl-btn" data-template="farmhouse">Farmhouse</button>
            <button class="tmpl-btn" data-template="heirloom">Heirloom</button>
          </div>
        </div>
        <div class="picker-group">
          <label>Size</label>
          <div class="size-picker">
            <button class="size-btn" data-size="3x5">3×5</button>
            <button class="size-btn" data-size="4x6">4×6</button>
            <button class="size-btn active" data-size="5x7">5×7</button>
            <button class="size-btn" data-size="full">Full</button>
          </div>
        </div>
      </div>
    </div>
    <div class="card-wrapper">
      <div id="recipe-card" class="recipe-card template-grandma size-5x7 fade-up"></div>
    </div>
    <div class="no-print action-bar fade-up">
      <button id="print-btn" class="btn-action">🖨 Print</button>
      <button id="download-btn" class="btn-action">📥 Download Image</button>
      <button id="email-btn" class="btn-action">✉️ Copy Email HTML</button>
      <button id="new-btn" class="btn-new">+ New Recipe</button>
    </div>
  </section>

  <!-- Email HTML Modal -->
  <div id="email-modal" class="modal" style="display:none;">
    <div class="modal-content">
      <button id="close-modal" class="btn-remove modal-close">✕</button>
      <h3>Email-Friendly HTML</h3>
      <p>Copy and paste into your email composer:</p>
      <textarea id="email-html" readonly rows="12"></textarea>
      <button id="copy-email" class="btn-primary" style="margin-top:12px;">📋 Copy to Clipboard</button>
    </div>
  </div>

  <footer class="no-print">
    <div class="container">
      <div class="footer-ornament">✿</div>
      <p class="footer-text">Made with love ✨</p>
    </div>
  </footer>

<style>
  /* ===== HEADER ===== */
  header {
    text-align: center;
    padding: 52px 0 36px;
  }
  .header-ornament {
    font-size: 0.9rem;
    letter-spacing: 12px;
    color: var(--sage-light);
    margin-bottom: 12px;
  }
  .logo h1 {
    font-size: 3.2rem;
    color: var(--dark);
    font-weight: 700;
    font-family: 'Playfair Display', serif;
    letter-spacing: -0.5px;
  }
  .tagline-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 8px;
  }
  .tagline {
    color: var(--warm-gray);
    font-size: 1rem;
    font-family: 'Caveat', cursive;
    font-size: 1.3rem;
  }
  .tagline-line {
    width: 50px;
    height: 1px;
    background: var(--sage-light);
  }

  /* ===== UPLOAD ===== */
  .drop-zone {
    border-radius: 20px;
    padding: 60px 32px;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    background: var(--warm-white);
    position: relative;
    overflow: hidden;
  }
  .drop-zone-border {
    position: absolute;
    inset: 8px;
    border: 2px dashed var(--sage-light);
    border-radius: 14px;
    pointer-events: none;
    transition: var(--transition);
  }
  .drop-zone:hover .drop-zone-border,
  .drop-zone.drag-over .drop-zone-border {
    border-color: var(--sage);
    inset: 5px;
  }
  .drop-zone:hover, .drop-zone.drag-over {
    background: var(--parchment);
    box-shadow: 0 8px 32px rgba(60,53,44,0.08);
  }
  .upload-icon { font-size: 3rem; margin-bottom: 14px; }
  .drop-zone h2 {
    font-size: 1.4rem;
    margin-bottom: 8px;
    color: var(--dark);
    font-family: 'Playfair Display', serif;
  }
  .drop-zone p { color: var(--warm-gray); font-size: 0.95rem; margin-bottom: 20px; }
  .upload-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: var(--warm-gray);
    font-size: 0.8rem;
    font-family: 'Inter', sans-serif;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .hint-line { width: 36px; height: 1px; background: var(--sage-light); }
  .preview-container { position: relative; display: inline-block; }
  .preview-container img {
    max-width: 100%;
    max-height: 360px;
    border-radius: 14px;
    object-fit: contain;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .btn-remove {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: rgba(60,53,44,0.7);
    color: white;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(6px);
    transition: var(--transition);
  }
  .btn-remove:hover { background: rgba(60,53,44,0.9); transform: scale(1.1); }

  /* ===== BUTTONS ===== */
  .btn-primary {
    display: block;
    margin: 24px auto 0;
    padding: 16px 44px;
    background: var(--sage);
    color: white;
    border: none;
    border-radius: 60px;
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Lora', serif;
  }
  .btn-primary:hover {
    background: var(--sage-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(122,139,111,0.3);
  }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .btn-action {
    padding: 12px 24px;
    background: var(--warm-white);
    border: 1.5px solid var(--cream-dark);
    border-radius: 60px;
    color: var(--dark);
    font-size: 0.88rem;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Lora', serif;
  }
  .btn-action:hover {
    border-color: var(--sage);
    background: var(--parchment);
    transform: translateY(-2px);
  }
  .btn-new {
    padding: 12px 24px;
    background: transparent;
    border: 1.5px solid var(--terracotta-light);
    border-radius: 60px;
    color: var(--terracotta);
    font-size: 0.88rem;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Lora', serif;
  }
  .btn-new:hover { background: var(--terracotta); color: white; }
  .spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 6px;
  }
  .error-msg {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #B91C1C;
    padding: 14px 20px;
    border-radius: 14px;
    margin-top: 20px;
    text-align: center;
    font-size: 0.95rem;
  }

  /* ===== CARD CONTROLS ===== */
  .card-controls {
    margin: 52px 0 24px;
    text-align: center;
  }
  .card-controls h2 {
    font-size: 1.5rem;
    margin-bottom: 20px;
    font-family: 'Playfair Display', serif;
  }
  .pickers-row {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .picker-group label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--warm-gray);
    margin-bottom: 8px;
    font-family: 'Inter', sans-serif;
  }
  .template-picker, .size-picker { display: flex; gap: 6px; }
  .tmpl-btn, .size-btn {
    padding: 8px 18px;
    border-radius: 60px;
    border: 1.5px solid var(--cream-dark);
    background: var(--warm-white);
    color: var(--dark-soft);
    cursor: pointer;
    font-size: 0.82rem;
    font-family: 'Lora', serif;
    transition: var(--transition);
  }
  .tmpl-btn.active, .tmpl-btn:hover,
  .size-btn.active, .size-btn:hover {
    background: var(--sage);
    color: white;
    border-color: var(--sage);
  }

  .card-wrapper {
    display: flex;
    justify-content: center;
    padding: 8px 0;
  }

  .action-bar {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 28px 0 60px;
  }

  /* ===== FOOTER ===== */
  footer { text-align: center; padding: 40px 0 28px; }
  .footer-ornament { color: var(--sage-light); font-size: 1.2rem; margin-bottom: 8px; }
  .footer-text { font-size: 0.85rem; color: var(--warm-gray); font-style: italic; }

  /* ===== MODAL ===== */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(60,53,44,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    backdrop-filter: blur(6px);
  }
  .modal-content {
    background: var(--warm-white);
    border-radius: 20px;
    padding: 32px;
    max-width: 600px;
    width: 90%;
    position: relative;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
  }
  .modal-close { position: absolute; top: 14px; right: 14px; }
  .modal-content h3 { margin-bottom: 8px; }
  .modal-content textarea {
    width: 100%;
    font-family: monospace;
    font-size: 0.8rem;
    border: 1px solid var(--cream-dark);
    border-radius: 10px;
    padding: 12px;
    resize: vertical;
    margin-top: 12px;
    background: white;
  }

  @media (max-width: 640px) {
    .logo h1 { font-size: 2.2rem; }
    .drop-zone { padding: 44px 20px; }
    .pickers-row { gap: 16px; }
    .card-controls { text-align: center; }
  }
</style>

<!-- Card styles must be global because HTML is injected via JS -->
<style is:global>
  /* ===== SIZE SYSTEM (landscape orientation) ===== */
  .recipe-card {
    overflow: hidden;
    position: relative;
    transition: all 0.3s ease;
  }
  .size-3x5 { width: 5in; height: 3in; overflow-y: auto; }
  .size-4x6 { width: 6in; height: 4in; overflow-y: auto; }
  .size-5x7 { width: 7in; height: 5in; overflow-y: auto; }
  .size-full { width: 100%; max-width: 800px; }

  /* ===== GRANDMA'S TEMPLATE ===== */
  .template-grandma {
    background: #FDF6E3;
    border-radius: 6px;
    box-shadow:
      0 2px 8px rgba(120,100,60,0.12),
      0 12px 40px rgba(120,100,60,0.08),
      inset 0 0 80px rgba(180,160,100,0.06);
    border: 1px solid #E8DCBE;
    font-family: 'Caveat', cursive;
  }
  .template-grandma::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 27px,
        rgba(140,180,220,0.15) 27px,
        rgba(140,180,220,0.15) 28px
      );
    pointer-events: none;
    z-index: 0;
  }
  .template-grandma::after {
    content: '';
    position: absolute;
    top: 0;
    left: 56px;
    bottom: 0;
    width: 1.5px;
    background: rgba(220,120,120,0.25);
    pointer-events: none;
    z-index: 0;
  }
  .template-grandma .card-header {
    padding: 20px 32px 10px 64px;
    position: relative;
    z-index: 1;
    border-bottom: none;
  }
  .template-grandma .card-header h2 {
    font-family: 'Caveat', cursive;
    font-size: 2rem;
    font-weight: 700;
    color: #4A3728;
    line-height: 1.2;
  }
  .template-grandma .card-header .desc {
    color: #8B7355;
    font-size: 1.2rem;
    margin-top: 2px;
  }
  .template-grandma .card-meta {
    display: flex;
    gap: 16px;
    padding: 4px 32px 8px 64px;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
  }
  .template-grandma .meta-item {
    font-size: 1.1rem;
    color: #8B7355;
  }
  .template-grandma .meta-item strong {
    color: #4A3728;
    margin-right: 2px;
  }
  .template-grandma .card-body {
    padding: 8px 32px 24px 64px;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 12px 24px;
  }
  .template-grandma .section-title {
    font-family: 'Caveat', cursive;
    font-size: 1.3rem;
    color: #4A3728;
    margin-bottom: 8px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(220,120,120,0.3);
    text-underline-offset: 4px;
  }
  .template-grandma .ingredients-list {
    list-style: none;
    margin-bottom: 0;
  }
  .template-grandma .ingredients-list li {
    padding: 1px 0;
    font-size: 1.05rem;
    color: #4A3728;
    line-height: 1.5;
  }
  .template-grandma .ingredients-list li::before {
    content: '- ';
    color: #8B7355;
  }
  .template-grandma .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-grandma .instructions-list li {
    padding: 2px 0;
    font-size: 1rem;
    color: #4A3728;
    counter-increment: step;
    line-height: 1.5;
  }
  .template-grandma .instructions-list li::before {
    content: counter(step) '. ';
    color: #8B7355;
    font-weight: 700;
  }
  .template-grandma .card-notes {
    grid-column: 1 / -1;
    margin-top: 4px;
    padding: 6px 10px;
    font-size: 0.95rem;
    color: #8B7355;
    font-style: italic;
    border-top: 1px dashed rgba(180,160,100,0.4);
  }
  .template-grandma .card-notes strong {
    color: #4A3728;
    font-style: normal;
  }

  /* ===== VINTAGE TEMPLATE ===== */
  .template-vintage {
    background: #FAF4EA;
    border-radius: 4px;
    border: 3px double #C8B896;
    box-shadow: 0 6px 32px rgba(100,80,50,0.1);
    position: relative;
    font-family: 'Lora', serif;
  }
  .template-vintage::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid #D8CAA8;
    border-radius: 2px;
    pointer-events: none;
  }
  .template-vintage .card-header {
    padding: 28px 40px 12px;
    text-align: center;
    position: relative;
  }
  .template-vintage .card-header::after {
    content: '❦';
    display: block;
    font-size: 1.4rem;
    color: #C8B896;
    margin-top: 12px;
  }
  .template-vintage .card-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: #3C2F1E;
    font-style: italic;
  }
  .template-vintage .card-header .desc {
    color: #8B7D68;
    font-style: italic;
    font-size: 0.95rem;
    margin-top: 4px;
  }
  .template-vintage .card-meta {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 14px 48px;
    flex-wrap: wrap;
  }
  .template-vintage .meta-item {
    font-size: 0.85rem;
    color: #8B7D68;
    padding: 6px 16px;
    border: 1px solid #D8CAA8;
    border-radius: 4px;
    background: rgba(255,255,255,0.4);
  }
  .template-vintage .meta-item strong {
    display: block;
    color: #3C2F1E;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
  }
  .template-vintage .card-body {
    padding: 16px 40px 32px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 12px 24px;
  }
  .template-vintage .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    color: #3C2F1E;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 600;
    margin-bottom: 10px;
    text-align: center;
    position: relative;
  }
  .template-vintage .section-title::after {
    content: '';
    display: block;
    width: 50px;
    height: 1px;
    background: #C8B896;
    margin: 8px auto 0;
  }
  .template-vintage .ingredients-list {
    list-style: none;
    margin-bottom: 0;
  }
  .template-vintage .ingredients-list li {
    padding: 5px 0 5px 18px;
    position: relative;
    break-inside: avoid;
    font-size: 0.92rem;
    color: #4A3D2E;
  }
  .template-vintage .ingredients-list li::before {
    content: '◇';
    position: absolute;
    left: 0;
    color: #C8B896;
    font-size: 0.6rem;
    top: 9px;
  }
  .template-vintage .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-vintage .instructions-list li {
    padding: 10px 0 10px 40px;
    position: relative;
    font-size: 0.92rem;
    counter-increment: step;
    color: #4A3D2E;
    border-bottom: 1px dotted #D8CAA8;
    line-height: 1.7;
  }
  .template-vintage .instructions-list li:last-child { border-bottom: none; }
  .template-vintage .instructions-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 8px;
    width: 28px;
    height: 28px;
    border: 1.5px solid #C8B896;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 600;
    color: #3C2F1E;
    font-family: 'Playfair Display', serif;
  }
  .template-vintage .card-notes {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding: 10px 16px;
    border: 1px solid #D8CAA8;
    border-radius: 4px;
    background: rgba(255,255,255,0.3);
    font-size: 0.88rem;
    color: #8B7D68;
    font-style: italic;
    text-align: center;
  }
  .template-vintage .card-notes strong { color: #3C2F1E; font-style: normal; }

  /* ===== FARMHOUSE TEMPLATE ===== */
  .template-farmhouse {
    background: #F5EEE4;
    border-radius: 16px;
    border: 2px solid #DDD2BE;
    box-shadow: 0 8px 36px rgba(80,60,40,0.1);
    position: relative;
    font-family: 'Lora', serif;
  }
  .template-farmhouse::before {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(180,165,130,0.3);
    border-radius: 10px;
    pointer-events: none;
  }
  .template-farmhouse .card-header {
    padding: 24px 40px 10px;
    text-align: center;
  }
  .template-farmhouse .card-header::after {
    content: '— 🌿 —';
    display: block;
    margin-top: 14px;
    color: #B5A882;
    font-size: 0.9rem;
    letter-spacing: 6px;
  }
  .template-farmhouse .card-header h2 {
    font-family: 'Caveat', cursive;
    font-size: 2.6rem;
    font-weight: 700;
    color: #3C352C;
  }
  .template-farmhouse .card-header .desc {
    color: #8A7F74;
    font-style: italic;
    font-size: 0.95rem;
    margin-top: 4px;
  }
  .template-farmhouse .card-meta {
    display: flex;
    justify-content: center;
    gap: 24px;
    padding: 16px 32px;
    flex-wrap: wrap;
  }
  .template-farmhouse .meta-item {
    text-align: center;
    font-size: 0.82rem;
    color: #8A7F74;
    padding: 8px 18px;
    background: rgba(255,255,255,0.5);
    border-radius: 10px;
    border: 1px solid #DDD2BE;
  }
  .template-farmhouse .meta-item strong {
    display: block;
    font-family: 'Caveat', cursive;
    font-size: 1.3rem;
    color: #5C6B52;
  }
  .template-farmhouse .card-body {
    padding: 16px 40px 32px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 12px 24px;
  }
  .template-farmhouse .section-title {
    font-family: 'Caveat', cursive;
    font-size: 1.3rem;
    color: #5C6B52;
    margin-bottom: 8px;
    text-align: center;
  }
  .template-farmhouse .section-title::after {
    content: '';
    display: block;
    width: 50px;
    height: 2px;
    background: #B5C4A8;
    margin: 6px auto 0;
  }
  .template-farmhouse .ingredients-list {
    list-style: none;
    margin-bottom: 0;
    padding: 14px 18px;
    background: rgba(255,255,255,0.4);
    border-radius: 12px;
    border: 1px dashed #B5C4A8;
  }
  .template-farmhouse .ingredients-list li {
    padding: 4px 0 4px 20px;
    position: relative;
    break-inside: avoid;
    font-size: 0.92rem;
  }
  .template-farmhouse .ingredients-list li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: #B5C4A8;
    font-size: 0.5rem;
    top: 10px;
  }
  .template-farmhouse .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-farmhouse .instructions-list li {
    padding: 12px 0 12px 44px;
    position: relative;
    font-size: 0.92rem;
    counter-increment: step;
    line-height: 1.7;
    border-bottom: 1px dashed #DDD2BE;
  }
  .template-farmhouse .instructions-list li:last-child { border-bottom: none; }
  .template-farmhouse .instructions-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 10px;
    width: 30px;
    height: 30px;
    border: 2px solid #B5C4A8;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Caveat', cursive;
    font-size: 1.15rem;
    font-weight: 600;
    color: #5C6B52;
  }
  .template-farmhouse .card-notes {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding: 10px 16px;
    background: rgba(255,255,255,0.4);
    border: 1px solid #DDD2BE;
    border-radius: 10px;
    font-size: 0.88rem;
    color: #8A7F74;
    font-style: italic;
    text-align: center;
  }
  .template-farmhouse .card-notes strong { color: #5C6B52; font-style: normal; }

  /* ===== HEIRLOOM TEMPLATE ===== */
  .template-heirloom {
    background: #FFFDF7;
    border-radius: 0;
    border: none;
    box-shadow: 0 4px 24px rgba(80,60,40,0.08);
    position: relative;
    font-family: 'Playfair Display', serif;
  }
  .template-heirloom::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 12px solid transparent;
    border-image: repeating-linear-gradient(
      45deg,
      #D4C5A0 0px, #D4C5A0 2px,
      transparent 2px, transparent 8px
    ) 12;
    pointer-events: none;
  }
  .template-heirloom .card-header {
    padding: 28px 44px 12px;
    text-align: center;
    position: relative;
  }
  .template-heirloom .card-header::before {
    content: '✦ ✦ ✦';
    display: block;
    color: #C8B280;
    font-size: 0.7rem;
    letter-spacing: 8px;
    margin-bottom: 16px;
  }
  .template-heirloom .card-header::after {
    content: '';
    display: block;
    width: 80px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #C8B280, transparent);
    margin: 16px auto 0;
  }
  .template-heirloom .card-header h2 {
    font-size: 2.2rem;
    font-weight: 700;
    color: #2C2418;
    letter-spacing: 1px;
  }
  .template-heirloom .card-header .desc {
    color: #8B7D68;
    font-style: italic;
    font-size: 1rem;
    margin-top: 6px;
    font-weight: 400;
  }
  .template-heirloom .card-meta {
    display: flex;
    justify-content: center;
    gap: 24px;
    padding: 8px 44px;
    flex-wrap: wrap;
  }
  .template-heirloom .meta-item {
    text-align: center;
    font-size: 0.82rem;
    color: #8B7D68;
    font-family: 'Lora', serif;
  }
  .template-heirloom .meta-item strong {
    display: block;
    font-size: 1.15rem;
    color: #2C2418;
    font-family: 'Playfair Display', serif;
  }
  .template-heirloom .card-body {
    padding: 16px 44px 32px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 32px;
  }
  .template-heirloom .section-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #C8B280;
    margin-bottom: 16px;
    font-weight: 600;
  }
  .template-heirloom .ingredients-list {
    list-style: none;
    border-right: 1px solid #E8DCC8;
    padding-right: 24px;
  }
  .template-heirloom .ingredients-list li {
    padding: 6px 0;
    font-size: 0.9rem;
    color: #3C2F1E;
    font-family: 'Lora', serif;
    border-bottom: 1px dotted #E8DCC8;
  }
  .template-heirloom .ingredients-list li:last-child { border-bottom: none; }
  .template-heirloom .instructions-list {
    list-style: none;
    counter-reset: step;
  }
  .template-heirloom .instructions-list li {
    padding: 8px 0;
    font-size: 0.9rem;
    color: #3C2F1E;
    counter-increment: step;
    font-family: 'Lora', serif;
    line-height: 1.7;
  }
  .template-heirloom .instructions-list li::before {
    content: counter(step) '.';
    color: #C8B280;
    font-weight: 700;
    margin-right: 8px;
    font-family: 'Playfair Display', serif;
  }
  .template-heirloom .card-notes {
    grid-column: 1 / -1;
    padding: 16px 0;
    border-top: 1px solid #E8DCC8;
    font-size: 0.85rem;
    color: #8B7D68;
    font-style: italic;
    text-align: center;
    font-family: 'Lora', serif;
  }
  .template-heirloom .card-notes strong { color: #2C2418; font-style: normal; }

  /* ===== RESPONSIVE CARD OVERRIDES ===== */
  @media (max-width: 640px) {
    .size-3x5, .size-4x6, .size-5x7, .size-full {
      width: 100% !important;
      min-height: auto !important;
    }
    .template-grandma .card-header,
    .template-grandma .card-body,
    .template-grandma .card-meta { padding-left: 48px; padding-right: 24px; }
    .template-grandma::after { left: 36px; }
    .template-vintage .card-header,
    .template-vintage .card-body { padding-left: 28px; padding-right: 28px; }
    .template-vintage .ingredients-list { columns: 1; }
    .template-farmhouse .card-header,
    .template-farmhouse .card-body { padding-left: 24px; padding-right: 24px; }
    .template-farmhouse .ingredients-list { columns: 1; }
    .template-heirloom .card-header,
    .template-heirloom .card-meta { padding-left: 28px; padding-right: 28px; }
    .template-heirloom .card-body {
      padding: 20px 28px 36px;
      grid-template-columns: 1fr;
    }
    .template-heirloom .ingredients-list { border-right: none; padding-right: 0; border-bottom: 1px solid #E8DCC8; padding-bottom: 16px; }
  }

  @media print {
    .recipe-card { box-shadow: none !important; }
    .size-3x5 { width: 5in; height: 3in; }
    .size-4x6 { width: 6in; height: 4in; }
    .size-5x7 { width: 7in; height: 5in; }
  }
</style>

<script>
  const $ = (s) => document.querySelector(s);
  const dropZone = $('#drop-zone');
  const fileInput = $('#file-input');
  const previewContainer = $('#preview-container');
  const previewImage = $('#preview-image');
  const extractBtn = $('#extract-btn');
  const cardSection = $('#card-section');
  const recipeCard = $('#recipe-card');
  const errorMsg = $('#error-msg');
  let base64Image = '';
  let currentRecipe = null;
  let currentTemplate = 'grandma';
  let currentSize = '5x7';

  // Upload
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', () => { if (fileInput.files[0]) handleFile(fileInput.files[0]); });

  function handleFile(file) {
    if (!file.type.startsWith('image/')) return showError('Please upload an image file.');
    if (file.size > 20 * 1024 * 1024) return showError('Image must be under 20MB.');
    const reader = new FileReader();
    reader.onload = (e) => {
      base64Image = e.target.result;
      previewImage.src = base64Image;
      previewContainer.style.display = 'inline-block';
      dropZone.querySelector('.drop-zone-content').style.display = 'none';
      extractBtn.style.display = 'block';
      hideError();
    };
    reader.readAsDataURL(file);
  }

  $('#remove-image').addEventListener('click', (e) => {
    e.stopPropagation();
    base64Image = '';
    previewContainer.style.display = 'none';
    dropZone.querySelector('.drop-zone-content').style.display = 'block';
    extractBtn.style.display = 'none';
    fileInput.value = '';
  });

  // Extract
  extractBtn.addEventListener('click', async () => {
    if (!base64Image) return;
    extractBtn.disabled = true;
    extractBtn.querySelector('.btn-text').style.display = 'none';
    extractBtn.querySelector('.btn-loading').style.display = 'inline';
    hideError();
    try {
      const res = await fetch('/api/extract-recipe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image: base64Image }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to extract recipe');
      currentRecipe = data;
      renderCard();
      cardSection.style.display = 'block';
      cardSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      showError(err.message);
    } finally {
      extractBtn.disabled = false;
      extractBtn.querySelector('.btn-text').style.display = 'inline';
      extractBtn.querySelector('.btn-loading').style.display = 'none';
    }
  });

  // Render
  function renderCard() {
    if (!currentRecipe) return;
    const r = currentRecipe;
    const ingredientsHtml = (r.ingredients || []).map(i => `<li>${i}</li>`).join('');
    const instructionsHtml = (r.instructions || []).map(i => `<li>${i}</li>`).join('');
    const notesHtml = r.notes ? `<div class="card-notes"><strong>Notes: </strong>${r.notes}</div>` : '';

    // All templates use two-column layout for landscape note card feel
    const bodyContent = `
      <div><h3 class="section-title">Ingredients</h3><ul class="ingredients-list">${ingredientsHtml}</ul></div>
      <div><h3 class="section-title">Instructions</h3><ol class="instructions-list">${instructionsHtml}</ol></div>
      ${notesHtml}`;

    recipeCard.className = `recipe-card template-${currentTemplate} size-${currentSize} fade-up`;
    recipeCard.innerHTML = `
      <div class="card-header">
        <h2>${r.title || 'Untitled Recipe'}</h2>
        ${r.description ? `<p class="desc">${r.description}</p>` : ''}
      </div>
      <div class="card-meta">
        <div class="meta-item"><strong>${r.prepTime || '—'}</strong> Prep</div>
        <div class="meta-item"><strong>${r.cookTime || '—'}</strong> Cook</div>
        <div class="meta-item"><strong>${r.servings || '—'}</strong> Servings</div>
      </div>
      <div class="card-body">${bodyContent}</div>
    `;
  }

  // Template switching
  document.querySelectorAll('.tmpl-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tmpl-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTemplate = btn.dataset.template;
      renderCard();
    });
  });

  // Size switching
  document.querySelectorAll('.size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentSize = btn.dataset.size;
      renderCard();
    });
  });

  // Actions
  $('#print-btn').addEventListener('click', () => window.print());

  $('#download-btn').addEventListener('click', async () => {
    const { default: html2canvas } = await import('html2canvas');
    // Scale based on size for print quality
    const scales = { '3x5': 3, '4x6': 3, '5x7': 2.5, 'full': 2 };
    const scale = scales[currentSize] || 2;
    const canvas = await html2canvas(recipeCard, { scale, useCORS: true, backgroundColor: null });
    const a = document.createElement('a');
    a.download = `${(currentRecipe?.title || 'recipe').replace(/\s+/g, '-').toLowerCase()}-${currentSize}.png`;
    a.href = canvas.toDataURL('image/png');
    a.click();
  });

  $('#email-btn').addEventListener('click', () => {
    if (!currentRecipe) return;
    const html = generateEmailHtml(currentRecipe);
    $('#email-html').value = html;
    $('#email-modal').style.display = 'flex';
  });

  $('#close-modal').addEventListener('click', () => { $('#email-modal').style.display = 'none'; });
  $('#email-modal').addEventListener('click', (e) => { if (e.target === $('#email-modal')) $('#email-modal').style.display = 'none'; });

  $('#copy-email').addEventListener('click', () => {
    $('#email-html').select();
    navigator.clipboard.writeText($('#email-html').value);
    $('#copy-email').textContent = '✅ Copied!';
    setTimeout(() => { $('#copy-email').textContent = '📋 Copy to Clipboard'; }, 2000);
  });

  $('#new-btn').addEventListener('click', () => {
    cardSection.style.display = 'none';
    base64Image = '';
    previewContainer.style.display = 'none';
    dropZone.querySelector('.drop-zone-content').style.display = 'block';
    extractBtn.style.display = 'none';
    fileInput.value = '';
    currentRecipe = null;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  function generateEmailHtml(r) {
    const ingredients = (r.ingredients || []).map(i => `<li style="padding:4px 0;">${i}</li>`).join('');
    const instructions = (r.instructions || []).map((s, i) => `<li style="padding:6px 0;"><strong>${i + 1}.</strong> ${s}</li>`).join('');
    return `<div style="max-width:600px;margin:0 auto;font-family:Georgia,serif;color:#3C352C;background:#FDF6E3;padding:32px;border:2px solid #D8CAA8;border-radius:4px;">
  <h1 style="text-align:center;font-size:28px;margin:0 0 4px;font-family:'Georgia',serif;color:#4A3728;">${r.title || 'Recipe'}</h1>
  ${r.description ? `<p style="text-align:center;color:#8B7355;font-style:italic;margin:4px 0 16px;">${r.description}</p>` : '<div style="margin-bottom:16px;"></div>'}
  <div style="text-align:center;font-size:14px;color:#8B7355;padding:10px 0;border-top:1px dashed #D8CAA8;border-bottom:1px dashed #D8CAA8;margin-bottom:20px;">
    ⏱ Prep: <strong style="color:#4A3728;">${r.prepTime || '—'}</strong> &nbsp;·&nbsp;
    🔥 Cook: <strong style="color:#4A3728;">${r.cookTime || '—'}</strong> &nbsp;·&nbsp;
    🍽 Serves: <strong style="color:#4A3728;">${r.servings || '—'}</strong>
  </div>
  <h2 style="font-size:18px;color:#4A3728;text-decoration:underline;text-decoration-color:#D8CAA8;text-underline-offset:4px;">Ingredients</h2>
  <ul style="list-style:none;padding:0;margin:8px 0 20px;">${(r.ingredients||[]).map(i=>`<li style="padding:3px 0;color:#4A3728;">- ${i}</li>`).join('')}</ul>
  <h2 style="font-size:18px;color:#4A3728;text-decoration:underline;text-decoration-color:#D8CAA8;text-underline-offset:4px;">Instructions</h2>
  <ol style="list-style:none;padding:0;margin:8px 0 0;">${instructions}</ol>
  ${r.notes ? `<div style="margin-top:20px;padding:12px;border-top:1px dashed #D8CAA8;font-size:14px;color:#8B7355;font-style:italic;"><strong style="font-style:normal;color:#4A3728;">Notes:</strong> ${r.notes}</div>` : ''}
</div>`;
  }

  function showError(msg) { errorMsg.textContent = msg; errorMsg.style.display = 'block'; }
  function hideError() { errorMsg.style.display = 'none'; }
</script>
</Layout>
